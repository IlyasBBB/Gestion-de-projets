# Copier ce fichier en .env puis adapter les valeurs.
# DEBUG=1 suffit en local : une clé secrète aléatoire est générée au démarrage.
DJANGO_DEBUG=1
# Obligatoire quand DJANGO_DEBUG=0 (générer avec :
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ex. https://projex.example.org quand l'application est servie en HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=
